# Binance API Configuration
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_TESTNET=true

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Database Configuration
DATABASE_PATH=./data/topshort.db

# Trading Configuration (Default Values - can be changed via Telegram)
MARGIN_PER_TRADE=100.0
MAX_POSITIONS=10
MAX_TOTAL_MARGIN=1000.0
DEFAULT_LEVERAGE=20
TAKE_PROFIT_PCT=5.0

# Market Scanning Configuration
PUMP_THRESHOLD_PCT=30.0
PUMP_PERIOD_HOURS_MIN=48
PUMP_PERIOD_HOURS_MAX=72
COOLDOWN_PERIOD_HOURS_MIN=4
COOLDOWN_PERIOD_HOURS_MAX=8
VOLUME_DECREASE_THRESHOLD_PCT=20.0

# Scheduler Configuration
SCAN_INTERVAL_MINUTES=60
MONITOR_INTERVAL_SECONDS=30

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/topshort.log
